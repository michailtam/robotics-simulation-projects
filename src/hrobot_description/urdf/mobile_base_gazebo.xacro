<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="WheelFR_link">
        <mu1 value="0.8" />
        <mu2 value="0.8" />
    </gazebo>

    <gazebo reference="WheelB_link">
        <mu1 value="0.8" />
        <mu2 value="0.8" />
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>WheelFL</left_joint>
            <right_joint>WheelFR</right_joint>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <wheel_separation>0.31</wheel_separation>
            <wheel_radius>0.08</wheel_radius>
            <min_velocity>-5</min_velocity>
            <max_velocity>5</max_velocity>
            <min_acceleration>-10</min_acceleration>
            <max_acceleration>10</max_acceleration>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        </plugin>
    </gazebo>

</robot>