<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Source: https://github.com/automaticaddison/yahboom_rosmaster/tree/main/yahboom_rosmaster_description/urdf/sensors -->

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <!-- RGBD camera -->
    <xacro:macro name="rgbd_camera" params="
        camera_name:='rgbd_camera'
        parent:='base_link'
        mesh_file:='file://$(find hrobot_description)/meshes/sensors/intel_realsense/d435.stl'
        xyz_offset:='0.105 0 0.05'
        rpy_offset:='0 -0.50 0'
        mesh_xyz_offset:='0 0 0'
        mesh_rpy_offset:='${M_PI/2} 0.0 ${M_PI/2}'
        collision_xyz_offset:='0 0 0'
        collision_rpy_offset:='0 0 0'
        inertial_xyz_offset:='0 0 0'
        inertial_rpy_offset:='0 0 0'
        optical_xyz_offset:='0 0 0'
        optical_rpy_offset:='${-M_PI/2} 0 ${-M_PI/2}'
        depth_frame_xyz_offset:='0 0 0'
        depth_frame_rpy_offset:='0 0 0'
        infra1_xyz_offset:='0 0 0'
        infra1_rpy_offset:='0 0 0'
        infra2_xyz_offset:='0 -0.05 0'
        infra2_rpy_offset:='0 0 0'
        color_xyz_offset:='0 0.015 0'
        color_rpy_offset:='0 0 0'
        cam_width:=0.090
        cam_height:=0.025
        cam_depth:=0.02505
        mass:=0.072
        ixx:=0.003881243
        ixy:=0.0
        ixz:=0.0
        iyy:=0.000498940
        iyz:=0.0
        izz:=0.003879257
        material_name:='aluminum'
        material_color:='0.8 0.8 0.8 1'
        horizontal_fov:=1.5184
        image_width:=424
        image_height:=240
        clip_near:=0.05
        clip_far:=1.5
        update_rate:=2
        always_on:=1
        visualize:=true
        enable_collision:=false">

        <link name="${camera_name}_link">
            <visual>
                <origin xyz="${mesh_xyz_offset}" rpy="${mesh_rpy_offset}"/>
                <geometry>
                    <!-- <mesh filename="${mesh_file}" /> -->
                    <box size=".03 .03 .03"/>
                </geometry>
                <material name="${material_name}">
                    <color rgba="${material_color}"/>
                </material>
            </visual>
            <collision>
                <origin xyz="${collision_xyz_offset}" rpy="${collision_rpy_offset}"/>
                <geometry>
                    <box size="${cam_depth} ${cam_width} ${cam_height}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="${mass}" />
                <origin xyz="${inertial_xyz_offset}" rpy="${inertial_rpy_offset}"/>
                <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
                        iyy="${iyy}" iyz="${iyz}" izz="${izz}" />
            </inertial>
        </link>
        <joint name="${camera_name}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${camera_name}_link" />
            <origin xyz="${xyz_offset}" rpy="${rpy_offset}"/>
        </joint>

        <joint name="${camera_name}_depth_joint" type="fixed">
            <origin xyz="${depth_frame_xyz_offset}" rpy="${depth_frame_rpy_offset}"/>
            <parent link="${camera_name}_link"/>
            <child link="${camera_name}_depth_frame" />
        </joint>
        <link name="${camera_name}_depth_frame"/>

        <joint name="${camera_name}_depth_optical_joint" type="fixed">
            <origin xyz="${optical_xyz_offset}" rpy="${optical_rpy_offset}" />
            <parent link="${camera_name}_depth_frame" />
            <child link="${camera_name}_depth_optical_frame" />
        </joint>
        <link name="${camera_name}_depth_optical_frame"/>

        <joint name="${camera_name}_infra1_joint" type="fixed">
            <origin xyz="${infra1_xyz_offset}" rpy="${infra1_rpy_offset}" />
            <parent link="${camera_name}_link" />
            <child link="${camera_name}_infra1_frame" />
        </joint>
        <link name="${camera_name}_infra1_frame"/>

        <joint name="${camera_name}_infra1_optical_joint" type="fixed">
            <origin xyz="${optical_xyz_offset}" rpy="${optical_rpy_offset}" />
            <parent link="${camera_name}_infra1_frame" />
            <child link="${camera_name}_infra1_optical_frame" />
        </joint>
        <link name="${camera_name}_infra1_optical_frame"/>

        <joint name="${camera_name}_infra2_joint" type="fixed">
            <origin xyz="${infra2_xyz_offset}" rpy="${infra2_rpy_offset}" />
            <parent link="${camera_name}_link" />
            <child link="${camera_name}_infra2_frame" />
        </joint>
        <link name="${camera_name}_infra2_frame"/>

        <joint name="${camera_name}_infra2_optical_joint" type="fixed">
            <origin xyz="${optical_xyz_offset}" rpy="${optical_rpy_offset}" />
            <parent link="${camera_name}_infra2_frame" />
            <child link="${camera_name}_infra2_optical_frame" />
        </joint>
        <link name="${camera_name}_infra2_optical_frame"/>

        <joint name="${camera_name}_color_joint" type="fixed">
            <origin xyz="${color_xyz_offset}" rpy="${color_rpy_offset}" />
            <parent link="${camera_name}_link" />
            <child link="${camera_name}_color_frame" />
        </joint>
        <link name="${camera_name}_color_frame"/>

        <joint name="${camera_name}_color_optical_joint" type="fixed">
            <origin xyz="${optical_xyz_offset}" rpy="${optical_rpy_offset}" />
            <parent link="${camera_name}_color_frame" />
            <child link="${camera_name}_color_optical_frame" />
        </joint>
        <link name="${camera_name}_color_optical_frame"/>

    </xacro:macro>

    <!-- Lidar sensor -->
    <xacro:macro name="lidar_sensor" params="
        parent:='base_link'
        frame_id:='laser_frame'
        mesh_file:='file://$(find hrobot_description)/meshes/sensors/rplidar/RPLIDAR_A3.STL'
        xyz_offset:='0 0 0.0825'
        rpy_offset:='0 0 0'
        mesh_xyz_offset:='0 0 0'
        mesh_rpy_offset:='0 0 0'
        mesh_scale:='0.001 0.001 0.001'
        collision_xyz_offset:='0 0 0'
        collision_rpy_offset:='0 0 0'
        inertial_xyz_offset:='0 0 0'
        inertial_rpy_offset:='0 0 0'
        lidar_width:=0.076
        lidar_height:=0.041
        mass:=0.185
        material_name:='rplidar_black'
        material_color:='0.13 0.13 0.13 1.0'
        gazebo_material_ambient:='0.1 0.1 0.1 1'
        gazebo_material_diffuse:='0.1 0.1 0.1 1'
        gazebo_material_specular:='0.1 0.1 0.1 1'
        update_rate:=10
        ray_count:=720
        min_angle:='-3.14159'
        max_angle:='3.14159'
        min_range:='0.20'
        max_range:='30.0'
        range_resolution:='0.013'
        topic_name:='scan'
        always_on:=true
        visualize:=false
        enable_collision:=false">

        <xacro:property name="radius" value="${lidar_width/2}" />
        <xacro:property name="ixx_iyy" value="${(mass/12) * (3 * radius * radius + lidar_height * lidar_height)}" />
        <xacro:property name="izz" value="${(mass/2) * (radius * radius)}" />

        <link name="${frame_id}_link">
            <visual>
                <origin xyz="-0.05 0 -0.029" rpy="1.57 0 0.8"/>
                <geometry>
                    <mesh filename="${mesh_file}" scale="${mesh_scale}"/>
                </geometry>
                <material name="${material_name}">
                <color rgba="${material_color}"/>
                </material>
            </visual>
            <collision>
                <origin xyz="${collision_xyz_offset}" rpy="${collision_rpy_offset}"/>
                <geometry>
                    <cylinder radius="${lidar_width/2}" length="${lidar_height}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="${mass}" />
                <origin xyz="${inertial_xyz_offset}" rpy="${inertial_rpy_offset}"/>
                <inertia
                ixx="${ixx_iyy}"
                ixy="0.0"
                ixz="0.0"
                iyy="${ixx_iyy}"
                iyz="0.0"
                izz="${izz}" />
            </inertial>
        </link>

        <joint name="${frame_id}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${frame_id}_link" />
            <origin xyz="${xyz_offset}" rpy="${rpy_offset}"/>
        </joint>

    </xacro:macro>

    <!-- IMU sensor -->
    <!-- <xacro:macro name="imu_sensor" params="
        parent:='base_link'
        frame_id:='imu'
        xyz_offset:='0 0 0'
        rpy_offset:='0 0 0'
        inertial_xyz_offset:='0 0 0'
        inertial_rpy_offset:='0 0 0'
        mass:=0.031
        length:=0.03899
        width:=0.03785
        height:=0.01338
        material_name:='imu_black'
        material_color:='0.1 0.1 0.1 1'
        gazebo_material_ambient:='0.1 0.1 0.1 1'
        gazebo_material_diffuse:='0.1 0.1 0.1 1'
        gazebo_material_specular:='0.1 0.1 0.1 1'
        update_rate:='15.0'
        topic_name:='imu/data'
        always_on:=true
        visualize:=false">

        <xacro:property name="ixx" value="${(mass/12.0) * (height*height + width*width)}" />
        <xacro:property name="iyy" value="${(mass/12.0) * (length*length + height*height)}" />
        <xacro:property name="izz" value="${(mass/12.0) * (length*length + width*width)}" />

        <link name="${frame_id}_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${length} ${width} ${height}"/>
                </geometry>
                <material name="${material_name}">
                    <color rgba="${material_color}"/>
                </material>
            </visual>

            <inertial>
                <mass value="${mass}" />
                <origin xyz="${inertial_xyz_offset}" rpy="${inertial_rpy_offset}"/>
                <inertia
                    ixx="${ixx}"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="${iyy}"
                    iyz="0.0"
                    izz="${izz}" />
            </inertial>
        </link>

        <joint name="${frame_id}_joint" type="fixed">
            <parent link="${parent}"/>
